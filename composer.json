{
    "name": "softspring/events",
    "description": "This component provides some useful event classes to use with Symfony",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.5 || ^10.0",
        "rector/rector": "^2.2",
        "symfony/form": "^6.4|^7.3",
        "symfony/http-foundation": "^6.4|^7.3"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\Component\\Events\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Softspring\\Component\\Events\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
